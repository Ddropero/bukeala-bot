{
  "manifest_version": 3,
  "name": "Bukeala Session Sender v5",
  "version": "5.1.0",
  "description": "v5.1: CAS heartbeat + auto-envío cada 5 min + órdenes remotas (/renovar_navegador renueva sin abrir el popup).",
  "permissions": ["cookies", "storage", "activeTab", "alarms", "tabs", "notifications"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bukeala session",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
